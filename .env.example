# ==============================================================
# CertChain: Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================

# Flask Configuration
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
SECRET_KEY=generate-a-secure-random-secret-key-here

# Storage Paths (Optional: defaults to local repository paths)
# DATABASE_PATH=/data/database.db
# QR_FOLDER=/data/qr_codes

# Blockchain Network Configuration
# Omit RPC_URL to use the built-in Py-EVM local node (zero configuration needed)
# To connect to external Ganache:
# RPC_URL=http://127.0.0.1:7545
# To connect to an Ethereum Testnet (Sepolia via Infura/Alchemy):
# RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# PRIVATE_KEY=0xYOUR_TESTNET_ACCOUNT_PRIVATE_KEY
# CONTRACT_ADDRESS=0xPRE_DEPLOYED_CONTRACT_ADDRESS_IF_ANY
